# Adres webhooka n8n (Respond to Webhook / HTTP Request)
WEBHOOK_URL=https://twoja-instancja.n8n.cloud/webhook/xyz-agent

# Opcjonalny sekret wysyłany w nagłówku x-webhook-secret
WEBHOOK_SECRET=

# Port backendu
PORT=3001

# Maksymalny czas oczekiwania na odpowiedź webhooka (ms)
WEBHOOK_TIMEOUT_MS=60000

# Opcjonalna lista originów frontendzu, oddzielona przecinkami.
# W trybie produkcyjnym można zostawić *, jeśli aplikacja jest serwowana z backendu.
ALLOWED_ORIGINS=http://localhost:5173
